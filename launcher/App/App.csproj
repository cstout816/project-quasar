<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>Quasar.Launcher</AssemblyName>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Quasar.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../Core/Core.csproj" /></ItemGroup>
  <ItemGroup><InternalsVisibleTo Include="Tests" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="Quasar.ico" LogicalName="Quasar.Icon" /></ItemGroup>
</Project>

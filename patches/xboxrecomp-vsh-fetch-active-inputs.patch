+static int check_input_mask(void)
+{
+    float full[NV2A_VSH_INPUTS][4], skipped[NV2A_VSH_INPUTS][4];
+    Nv2aVshOutput a, b;
+    unsigned mac, ilu, muxes, v, c, output_ilu;
+    const unsigned slot = 10;
+
+    for (v = 0; v < NV2A_VSH_INPUTS; ++v)
+        for (c = 0; c < 4; ++c)
+            full[v][c] = (float)(v + c + 1) / 16.0f;
+
+    /* A different input before and after the active FINAL must be ignored. */
+    {

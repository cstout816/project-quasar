+enum { SOURCE_B = 1, SOURCE_C = 2 };
+/* Every active MAC reads A. Only the binary and ternary ops also
+ * read B or C. A paired ILU always reads C before any writes. */
+static const uint8_t mac_extra_sources[16] = {
+    0, 0, SOURCE_B, SOURCE_C, SOURCE_B | SOURCE_C,
+    SOURCE_B, SOURCE_B, SOURCE_B, SOURCE_B, SOURCE_B,
+    SOURCE_B, SOURCE_B, SOURCE_B, 0, 0, 0
+};
+
+uint32_t nv2a_vsh_input_mask(void)
+{
+    uint32_t mask = 0, slot;
+
+    for (slot = s_start_slot; slot < NV2A_VSH_SLOTS; ++slot) {
+        const uint32_t *ins = s_program[slot];
+        uint32_t mac = field(ins, 1, 21, 4), ilu = field(ins, 1, 25, 3);
+        uint32_t sources = mac_extra_sources[mac];
+
+        /* All three operand muxes share the instruction's input index. */
+        if ((mac && field(ins, 2, 26, 2) == 2)
+            || ((sources & SOURCE_B) && field(ins, 2, 11, 2) == 2)
+            || ((ilu || (sources & SOURCE_C)) && field(ins, 3, 28, 2) == 2))
+            mask |= 1u << field(ins, 1, 9, 4);
+        if (field(ins, 3, 0, 1))
+            break;
+    }
+    return mask;
+}

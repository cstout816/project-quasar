+/* FATX title/user data keeps the old clusters when overwriting a file.
+ * A later write beyond zero can make the prefix visible again. In particular,
+ * Steel Battalion writes the pilot body, reopens it and appends its signature.
+ * Delay the Win32 EOF change until the first data operation. */
+#define FATX_PENDING_LIMIT 64
+static SRWLOCK s_fatx_lock = SRWLOCK_INIT;
+static HANDLE s_fatx_pending[FATX_PENDING_LIMIT];
+
+static int fatx_save_path(const char *path)
+{
+    static const char tdata[] = "\\Device\\Harddisk0\\Partition1\\TDATA\\";
+    static const char udata[] = "\\Device\\Harddisk0\\Partition1\\UDATA\\";
+    if (!path)
+        return 0;
+    if (_strnicmp(path, "\\??\\", 4) == 0)
+        path += 4;
+    return _strnicmp(path, "T:\\", 3) == 0 || _strnicmp(path, "U:\\", 3) == 0
+        || _strnicmp(path, tdata, sizeof(tdata) - 1) == 0
+        || _strnicmp(path, udata, sizeof(udata) - 1) == 0;
+}
+
+static int fatx_remember_overwrite(HANDLE handle)
+{
+    unsigned i;
+    AcquireSRWLockExclusive(&s_fatx_lock);
+    for (i = 0; i < FATX_PENDING_LIMIT; ++i) {
+        if (!s_fatx_pending[i]) {
+            s_fatx_pending[i] = handle;
+            break;
+        }
+    }
+    ReleaseSRWLockExclusive(&s_fatx_lock);
+    return i != FATX_PENDING_LIMIT;
+}
+
+static int fatx_has_overwrite(HANDLE handle)
+{
+    unsigned i;
+    if (!handle)
+        return 0;
+    AcquireSRWLockShared(&s_fatx_lock);
+    for (i = 0; i < FATX_PENDING_LIMIT && s_fatx_pending[i] != handle; ++i) {}
+    ReleaseSRWLockShared(&s_fatx_lock);
+    return i != FATX_PENDING_LIMIT;
+}
+
+static int fatx_finish_overwrite(HANDLE handle, LONGLONG end, int closing)
+{
+    unsigned i;
+    BOOL ok = TRUE;
+    FILE_END_OF_FILE_INFO size;
+    if (!handle)
+        return 1;
+    size.EndOfFile.QuadPart = end;
+    AcquireSRWLockExclusive(&s_fatx_lock);
+    for (i = 0; i < FATX_PENDING_LIMIT; ++i) {
+        if (s_fatx_pending[i] != handle)
+            continue;
+        ok = SetFileInformationByHandle(handle, FileEndOfFileInfo, &size, sizeof size);
+        if (ok || closing)
+            s_fatx_pending[i] = NULL;
+        break;
+    }
+    ReleaseSRWLockExclusive(&s_fatx_lock);
+    return ok;
+}

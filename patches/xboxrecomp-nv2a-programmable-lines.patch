+/* Lower a one-pixel programmable line to the existing triangle fragment
+ * path so it uses the same depth, combiner and blending state as the HUD. */
+static void raster_xf_line(const Nv2aVshOutput *a, const Nv2aVshOutput *b)
+{
+    Nv2aVshOutput edge, quad[4];
+    int front_a = a->pos[3] > NV_CLIP_W;
+    int front_b = b->pos[3] > NV_CLIP_W;
+    float dx, dy, length, nx, ny;
+
+    if (!front_a && !front_b)
+        return;
+    if (front_a != front_b) {
+        Nv2aVshOutput ca = *a, cb = *b;
+        const float *scale = nv2a_vsh_constant(58);
+        const float *offset = nv2a_vsh_constant(59);
+        float t = (NV_CLIP_W - a->pos[3]) / (b->pos[3] - a->pos[3]);
+
+        xf_to_clip(a, scale, offset, ca.pos);
+        xf_to_clip(b, scale, offset, cb.pos);
+        xf_lerp(&ca, &cb, t, &edge);
+        edge.pos[3] = NV_CLIP_W;
+        for (int i = 0; i < 3; ++i)
+            edge.pos[i] = edge.pos[i] / edge.pos[3] * scale[i] + offset[i];
+        if (!front_a)
+            a = &edge;
+        else
+            b = &edge;
+    }
+
+    dx = b->pos[0] - a->pos[0];
+    dy = b->pos[1] - a->pos[1];
+    length = hypotf(dx, dy);
+    if (length == 0.0f || !isfinite(length))
+        return;
+    nx = -0.5f * (dy / length);
+    ny = 0.5f * (dx / length);
+    quad[0] = quad[1] = *a;
+    quad[2] = quad[3] = *b;
+    quad[0].pos[0] += nx; quad[0].pos[1] += ny;
+    quad[1].pos[0] -= nx; quad[1].pos[1] -= ny;
+    quad[2].pos[0] -= nx; quad[2].pos[1] -= ny;
+    quad[3].pos[0] += nx; quad[3].pos[1] += ny;
+
+    raster_xf_triangle(&quad[0], &quad[1], &quad[2]);
+    raster_xf_triangle(&quad[0], &quad[2], &quad[3]);
+}

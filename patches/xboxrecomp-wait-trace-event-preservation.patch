+        memset(G(event), 0, 16);
+        memset(G(timeout), 0, 8);
+        *G(event) = 0x00040001u; /* Signaled synchronization event. */
+        *G(event + 4) = 1;
+        check(call(S_EVENT_WAIT, 5, args) == 0,

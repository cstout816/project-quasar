+/* Decode the whole 4x4 block from one stable copy of its compressed bytes. */
+static inline int d3d8_dxt_decode_block(const uint8_t *block, uint32_t fmt,
+                                       uint32_t argb[16])
+{
+    uint32_t bytes = d3d8_format_dxt_block_bytes(fmt);
+    const uint8_t *color;
+    uint32_t c[4], selectors, c0, c1, i;
+    int four_colors;
+
+    if (!bytes)
+        return 0;
+    color = block + (bytes - 8u);
+    c0 = (uint32_t)color[0] | ((uint32_t)color[1] << 8);
+    c1 = (uint32_t)color[2] | ((uint32_t)color[3] << 8);
+    selectors = (uint32_t)color[4] | ((uint32_t)color[5] << 8)
+              | ((uint32_t)color[6] << 16) | ((uint32_t)color[7] << 24);
+    four_colors = bytes == 16 || c0 > c1;
+    for (i = 0; i < 2; ++i) {
+        uint32_t rgb = i ? c1 : c0;
+        c[i] = 0xFF000000u
+             | (d3d8_expand_channel((rgb >> 11) & 31u, 5) << 16)
+             | (d3d8_expand_channel((rgb >> 5) & 63u, 6) << 8)
+             | d3d8_expand_channel(rgb & 31u, 5);
+    }
+    c[2] = 0xFF000000u;
+    c[3] = four_colors ? 0xFF000000u : 0;
+    for (i = 0; i < 3; ++i) {
+        uint32_t shift = i * 8u, a = (c[0] >> shift) & 255u, b = (c[1] >> shift) & 255u;
+        if (four_colors) {
+            c[2] |= ((2u * a + b) / 3u) << shift;
+            c[3] |= ((a + 2u * b) / 3u) << shift;
+        } else {
+            c[2] |= ((a + b) / 2u) << shift;
+        }
+    }
+
+    if (fmt == 0x0C) {
+        for (i = 0; i < 16; ++i)
+            argb[i] = c[(selectors >> (2u * i)) & 3u];
+    } else if (fmt == 0x0E) {
+        for (i = 0; i < 16; ++i) {
+            uint32_t nibble = (block[i >> 1] >> ((i & 1u) * 4u)) & 15u;
+            argb[i] = (nibble * 17u << 24) | (c[(selectors >> (2u * i)) & 3u] & 0xFFFFFFu);
+        }
+    } else {
+        uint32_t a[8] = {block[0], block[1]};
+        uint64_t bits = 0;
+        for (i = 0; i < 6; ++i)
+            bits |= (uint64_t)block[2 + i] << (8u * i);
+        if (a[0] > a[1]) {
+            for (i = 1; i < 7; ++i)
+                a[i + 1] = ((7u - i) * a[0] + i * a[1]) / 7u;
+        } else {
+            for (i = 1; i < 5; ++i)
+                a[i + 1] = ((5u - i) * a[0] + i * a[1]) / 5u;
+            a[7] = 255u;
+        }
+        for (i = 0; i < 16; ++i) {
+            uint32_t alpha = a[(bits >> (3u * i)) & 7u];
+            argb[i] = (alpha << 24) | (c[(selectors >> (2u * i)) & 3u] & 0xFFFFFFu);
+        }
+    }
+    return 1;
+}

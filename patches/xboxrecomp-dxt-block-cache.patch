+/* Decode a texel from a block-compressed image. */
+static inline int d3d8_dxt_decode_texel(const uint8_t *base, uint32_t fmt,
+                                        uint32_t u, uint32_t v,
+                                        uint32_t width, uint32_t *argb)
+{
+    uint32_t bytes = d3d8_format_dxt_block_bytes(fmt), blocks_per_row = (width + 3u) / 4u;
+    uint32_t block[16];
+    if (!bytes || !blocks_per_row)
+        return 0;
+    base += ((size_t)(v >> 2) * blocks_per_row + (u >> 2)) * bytes;
+    if (!d3d8_dxt_decode_block(base, fmt, block))
+        return 0;
+    *argb = block[(v & 3u) * 4u + (u & 3u)];
+    return 1;
+}

+static int check_dxt_cache_update(void)
+{
+    enum { TEX_AT = 0x78000 };
+    const uint32_t red = 0xFFFF0000u, blue = 0xFF0000FFu;
+    const uint32_t left = COLOR_AT + 4u * (30u * W + 16u);
+    const uint32_t right = COLOR_AT + 4u * (30u * W + 48u);
+    const uint8_t block[8] = {0x00, 0xF8, 0x1F, 0x00};
+    uint32_t before[2], after[2];
+
+    memcpy(s_mem + TEX_AT, block, sizeof(block));
+    m(0x1B00, TEX_AT);
+    m(0x1B04, (0x0Cu << 8) | (2u << 20) | (2u << 24));
+    draw_textured_quad(1.0f, 0);
+    memcpy(&before[0], s_mem + left, 4);
+    memcpy(&before[1], s_mem + right, 4);
+    memset(s_mem + TEX_AT + 4, 0x55, 4); /* Select the blue endpoint in place. */
+    draw_textured_quad(1.0f, 0);
+    memcpy(&after[0], s_mem + left, 4);
+    memcpy(&after[1], s_mem + right, 4);
+    if (!close_rgb(before[0], red) || !close_rgb(before[1], red)
+        || !close_rgb(after[0], blue) || !close_rgb(after[1], blue)) {
+        printf("DXT cache update: before %08X/%08X after %08X/%08X\n",
+               before[0], before[1], after[0], after[1]);
+        return 0;
+    }
+    puts("DXT cache refreshes after an in-place compressed update");
+    return 1;
+}

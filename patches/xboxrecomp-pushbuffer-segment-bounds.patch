+static int pb_segment_target_mapped(uint32_t source, uint32_t header,
+                                    uint32_t target, uint32_t mapped_end)
+{
+    static unsigned rejected;
+    if (target >= XBOX_CONTIG_BASE && target < mapped_end)
+        return 1;
+    if (rejected++ < 32u) {
+        fprintf(stderr, "  [PB-SEGMENT-BOUNDS] source=0x%08X header=0x%08X "
+                        "target=0x%08X mapped_end=0x%08X\n",
+                source, header, target, mapped_end);
+    }
+    return 0;
+}
+
+static uint32_t pb_segment_subroutine_end(uint32_t va, uint32_t mapped_end)
+{
+    return mapped_end - va > PB_SEGMENT_MAX_BYTES
+        ? va + PB_SEGMENT_MAX_BYTES : mapped_end;
+}

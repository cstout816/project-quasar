+/* Keep the recurring intro miss separately attributed so earlier misses
+ * cannot consume its first detailed records. All misses still count. */
+__declspec(noinline) void recomp_icall_fail_log(uint32_t va)
+{
+    static volatile LONG64 missed;
+    static volatile LONG64 intro_missed;
+    uint64_t total = (uint64_t)InterlockedIncrement64(&missed);
+    int intro = va == 0x0004AC44u;
+    uint64_t n = intro ? (uint64_t)InterlockedIncrement64(&intro_missed) : total;
+
+    if (n > 16 && (n & (n - 1)) != 0)
+        return;
+
+    if (n <= 16) {
+        uintptr_t image = (uintptr_t)GetModuleHandleW(NULL);
+        uintptr_t caller = (uintptr_t)_ReturnAddress();
+        uint32_t sp = g_esp;
+        uint32_t back = 0;
+        SIZE_T read = 0;
+        BOOL known = ReadProcessMemory(GetCurrentProcess(),
+                (const void *)((uintptr_t)xbox_GetMemoryOffset() + sp),
+                &back, sizeof back, &read) && read == sizeof back;
+        fprintf(stderr,
+                "[ICALL] Failed to resolve VA 0x%08X n=%llu total=%llu "
+                "tid=%lu native_rva=%llX guest_esp=%08X guest_return=%08X valid=%d\n",
+                va, (unsigned long long)n, (unsigned long long)total,
+                (unsigned long)GetCurrentThreadId(), (unsigned long long)(caller - image),
+                sp, back, (int)known);
+    } else {
+        fprintf(stderr,
+                "[ICALL-COUNT] group=%s last_va=%08X n=%llu total=%llu\n",
+                intro ? "intro" : "all", va,
+                (unsigned long long)n, (unsigned long long)total);
+    }
+    fflush(stderr);
+}

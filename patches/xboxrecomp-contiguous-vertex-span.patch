+#ifdef _WIN32
+static int check_contiguous_vertices(void)
+{
+    const uint32_t alias = 0x80000000u, window = 0x2000u, stride = 26;
+    const uint32_t color = 0xFF3679BCu;
+    const uint32_t pixel = COLOR_AT + 4u * (30u * W + 30u);
+    const float vertices[3][3] = {{16, 16, 0}, {100, 16, 0}, {16, 100, 0}};
+    uint8_t *memory = VirtualAlloc(NULL, (size_t)alias + window + 0x1000,
+                                   MEM_RESERVE, PAGE_NOACCESS);
+    uint32_t got = 0, crossing = 0;
+    int i, initialized = 0;
+
+    if (memory && VirtualAlloc(memory, MEM_BYTES, MEM_COMMIT, PAGE_READWRITE)
+        && VirtualAlloc(memory + alias, window, MEM_COMMIT, PAGE_READWRITE)) {
+        s_guest_base = memory;
+        s_contiguous_bytes = window;
+        for (i = 0; i < 3; ++i) {
+            memcpy(memory + alias + 0x1000 + i * stride, vertices[i], 12);
+            memcpy(memory + DIFF_AT + i * 4, &color, 4);
+        }
+        m(0x1720, 0x1000); /* Physical vertex address resolved to the high window. */
+        m(0x1760, 2 | (3 << 4) | (stride << 8));
+        m(0x17FC, 5);
+        m(0x1810, 2u << 24);
+        m(0x17FC, 0);
+        memcpy(&got, memory + pixel, 4);
+
+        memset(memory + COLOR_AT, 0, W * H * 4);
+        for (i = 0; i < 2; ++i)
+            memcpy(memory + alias + window - (2 - i) * stride, vertices[i], 12);
+        m(0x1720, window - 2 * stride);
+        m(0x17FC, 5);
+        m(0x1810, 2u << 24); /* The third vertex starts in an uncommitted page. */
+        m(0x17FC, 0);
+        memcpy(&crossing, memory + pixel, 4);
+        initialized = 1;
+        s_guest_base = s_mem;
+        s_contiguous_bytes = 0;
+    }
+    if (memory)
+        VirtualFree(memory, 0, MEM_RELEASE);
+    if (!initialized || !close_rgb(got, color) || crossing) {
+        printf("Contiguous vertex range: allocated=%d pixel=%08X crossing=%08X\n",
+               initialized, got, crossing);
+        return 0;
+    }
+    puts("Disjoint contiguous vertex stream rendered and its upper bound was enforced");
+    return 1;
+}
+#endif

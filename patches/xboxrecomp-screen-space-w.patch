+/* One screen-space quad with deliberately different texels on either side.
+ * An unbounded W produces 0/0 when the executor reconstructs the UVs. */
+static void draw_textured_quad(float w)
+{
+    static const float corners[4][4] = {
+        {8, 8, 0, 0}, {56, 8, 2, 0}, {8, 56, 0, 1}, {56, 56, 2, 1},
+    };
+    for (uint32_t i = 0; i < 4; ++i) {
+        float attrs[12] = {
+            corners[i][0], corners[i][1], 0, w,
+            1, 1, 1, 1, corners[i][2], corners[i][3], 0, 1,
+        };
+        memcpy(s_mem + POS_AT + sizeof(attrs) * i, attrs, sizeof(attrs));
+    }
+    memset(s_mem + COLOR_AT, 0, W * H * 4);
+    m(0x17FC, 6);
+    m(0x1810, 3u << 24);
+    m(0x17FC, 0);
+}
+
+static int check_unbounded_screen_w(void)
+{
+    enum { TEX_AT = 0x78000 };
+    static const uint32_t texels[2] = {0xFFFF0000u, 0xFF0000FFu};
+    static const uint32_t inputs[3] = {0, 3, 9}, outputs[3] = {0, 3, 9};
+    uint32_t finite[2], unbounded[2];
+    const uint32_t left = COLOR_AT + 4u * (30u * W + 16u);
+    const uint32_t right = COLOR_AT + 4u * (30u * W + 48u);
+    memcpy(s_mem + TEX_AT, texels, sizeof(texels));
+    for (unsigned i = 0; i < 3; ++i) {
+        uint32_t mov[4] = {
+            0, (1u << 21) | (inputs[i] << 9) | 0x1Bu, 2u << 26,
+            (0xFu << 12) | (1u << 11) | (outputs[i] << 3) | (i == 2),
+        };
+        nv2a_vsh_set_instruction(i, mov);
+    }
+    m(0x1E94, 2);
+    m(0x1720, POS_AT);      m(0x1760, 2 | (4 << 4) | (48 << 8));
+    m(0x172C, POS_AT + 16); m(0x176C, 2 | (4 << 4) | (48 << 8));
+    m(0x1744, POS_AT + 32); m(0x1784, 2 | (4 << 4) | (48 << 8));
+    m(0x1B00, TEX_AT);
+    m(0x1B04, 0x12u << 8);
+    m(0x1B08, 0x303);
+    m(0x1B10, 8u << 16);
+    m(0x1B1C, (2u << 16) | 1u);
+    draw_textured_quad(1.0f);
+    memcpy(&finite[0], s_mem + left, 4);
+    memcpy(&finite[1], s_mem + right, 4);
+    draw_textured_quad(INFINITY);
+    memcpy(&unbounded[0], s_mem + left, 4);
+    memcpy(&unbounded[1], s_mem + right, 4);
+    if (!close_rgb(finite[0], texels[0]) || !close_rgb(finite[1], texels[1])
+        || !close_rgb(unbounded[0], texels[0]) || !close_rgb(unbounded[1], texels[1])) {
+        printf("screen W texture: finite %08X/%08X, infinite %08X/%08X\n",
+               finite[0], finite[1], unbounded[0], unbounded[1]);
+        return 0;
+    }
+    puts("Screen-space infinite W preserves both distinct texels");
+    return 1;
+}

diff --git a/src/kernel/nv2a_pb_exec.c b/src/kernel/nv2a_pb_exec.c
--- a/src/kernel/nv2a_pb_exec.c
+++ b/src/kernel/nv2a_pb_exec.c
@@ -3340,6 +3340,11 @@
      * coordinates; preserve -0 as behind the eye, matching xemu/upstream #188. */
     if (out->pos[3] == 0.0f && !signbit(out->pos[3]))
         out->pos[3] = 1.0f;
+    /* Screen-space W saturates at signed 2^64 on NV2A. Leaving it
+     * infinite makes both UV/W and 1/W zero before interpolation.
+     * See xemu's programmable vertex output clamp. */
+    if (isinf(out->pos[3]))
+        out->pos[3] = copysignf(18446744073709551616.0f, out->pos[3]);
     return 1;
 }
 
